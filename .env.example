# ---------------------------------------------------------------------------
# Impiricus Ambient — environment configuration (HACKATHON PROTOTYPE)
# Copy to `.env` in the repo root. Never commit real secrets.
# The backend reads this via app/config.py; the frontend reads NEXT_PUBLIC_*
# variables via frontend/lib/env.ts (copy them to frontend/.env.local).
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# --- Database (Tiger Data / TimescaleDB-compatible PostgreSQL + pgvector) ---
# Local docker-compose DB (mapped to 5433 to avoid clashing with a local Postgres):
DATABASE_URL=postgresql+asyncpg://ambient:ambient@localhost:5433/ambient
# Tiger Data cloud example (postgres://... URLs and ?sslmode=require are normalized automatically):
# DATABASE_URL=postgres://tsdbadmin:<password>@<service>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require

# --- Google Gemini ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Must match the vector column dimension (see docs/DATABASE.md before changing).
GEMINI_EMBEDDING_DIMENSION=768

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

# --- Mock-first development ---
# true = deterministic fixtures, no paid API calls. Real providers are also
# skipped automatically when their API key is empty.
USE_MOCK_AI=true
USE_MOCK_VOICE=true
# Text the mock speech-to-text provider "hears".
MOCK_STT_TEXT=What's changed with Novara since I last looked at it?

# --- URLs ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Frontend (copy into frontend/.env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# true = frontend uses in-browser fixtures and never calls the backend.
NEXT_PUBLIC_USE_MOCK_API=false
